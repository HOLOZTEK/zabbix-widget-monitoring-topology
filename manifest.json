{
    "manifest_version": 2.0,
    "id": "monitoringmap",
    "type": "widget",
    "name": "Monitoring Map",
    "namespace": "MonitoringMap",
    "version": "0.2.1",
    "widget": {
        "size": {"width": 12, "height": 8},
        "js_class": "CWidgetMonitoringMap",
        "in": {
            "hostid": {"type": "_hostid"},
            "hostgroupid": {"type": "_hostgroupid"}
        }
    },
    "actions": {
        "widget.monitoringmap.view": {
            "class": "WidgetView"
        }
    },
    "assets": {
        "css": ["widget.css"],
        "js": ["vis-network.min.js", "class.widget.js"]
    }
}

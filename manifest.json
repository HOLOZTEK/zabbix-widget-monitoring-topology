{
    "manifest_version": 2.0,
    "id": "holoztek_monitoringmap",
    "type": "widget",
    "name": "Monitoring Topology",
    "namespace": "HoloztekMonitoringMap",
    "author": "HOLOZTEK",
    "version": "1.0.9",
    "widget": {
        "size": {"width": 12, "height": 8},
        "js_class": "CWidgetHoloztekMonitoringMap",
        "in": {
            "hostid": {"type": "_hostid"},
            "hostgroupid": {"type": "_hostgroupid"}
        }
    },
    "actions": {
        "widget.holoztek_monitoringmap.view": {
            "class": "WidgetView"
        }
    },
    "assets": {
        "css": ["widget.css"],
        "js": ["vis-network.min.js", "class.widget.js"]
    }
}
